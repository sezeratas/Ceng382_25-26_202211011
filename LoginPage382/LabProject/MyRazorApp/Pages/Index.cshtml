@page
@model MyRazorApp.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="container mt-4">
    <div class="row">
        <!-- Sol Panel -->
        <div class="col-md-4">
            <h4>Add New Class</h4>
            <form method="post" asp-page-handler="Add">
                <div class="form-group">
                    <label asp-for="NewClass.ClassName"></label>
                    <input asp-for="NewClass.ClassName" class="form-control" />
                    <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="NewClass.StudentCount"></label>
                    <input asp-for="NewClass.StudentCount" class="form-control" />
                    <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="NewClass.Description"></label>
                    <textarea asp-for="NewClass.Description" class="form-control"></textarea>
                    <span asp-validation-for="NewClass.Description" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary mt-2">Add Class</button>
            </form>
        </div>

        <!-- Sağ Panel -->
        <div class="col-md-8">
            <h4>Class List</h4>

            <!-- Filter Form -->
            <form method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" name="Filter" value="@Model.Filter" class="form-control" placeholder="Filter by Class Name" />
                    <button type="submit" class="btn btn-outline-primary">Filter</button>
                </div>
            </form>

            <!-- Table -->
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.FilteredTable)
                    {
                        <tr>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <form method="post">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" asp-page-handler="Edit" class="btn btn-warning btn-sm">Edit</button>
                                </form>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            <nav>
                <ul class="pagination">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" href="?Filter=@Model.Filter&PageNumber=@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

