@page
@model MyRazorApp.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="container mt-4">
    <div class="row">
        <!-- Sol Panel -->
        <div class="col-md-4">
            <h4>Add New Class</h4>
            <form method="post" asp-page-handler="Add">
                <div class="form-group">
                    <label asp-for="NewClass.Name"></label>
                    <input asp-for="NewClass.Name" class="form-control" />
                    <span asp-validation-for="NewClass.Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="NewClass.PersonCount"></label>
                    <input asp-for="NewClass.PersonCount" class="form-control" />
                    <span asp-validation-for="NewClass.PersonCount" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="NewClass.Description"></label>
                    <textarea asp-for="NewClass.Description" class="form-control"></textarea>
                </div>

                <button type="submit" class="btn btn-primary mt-2">Add Class</button>
            </form>
        </div>

        <!-- Sağ Panel -->
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4>Class List</h4>
            </div>

            <!-- Filtre Formu -->
            <form method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" asp-for="Filter" class="form-control" placeholder="Filter by Class Name" />
                    <button type="submit" class="btn btn-outline-primary">Filter</button>
                </div>
            </form>

            <!-- Tablo -->
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Person Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
<tbody>
    @if (Model.ClassList != null)
    {
        @foreach (var item in Model.ClassList)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.PersonCount</td>
                <td>@item.Description</td>
                <td>
                    <form method="post" class="d-inline">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="4">No data available.</td>
        </tr>
    }
</tbody>
            </table>

            <!-- Sayfalama -->
            <nav>
                <ul class="pagination">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" href="?Filter=@Model.Filter&PageNumber=@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}