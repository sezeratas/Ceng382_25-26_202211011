@page
@model MyRazorApp.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<style>
    /* Sütun vurgulama stilleri */
    .column-highlight {
        background-color: rgba(0, 123, 255, 0.1) !important;
        transition: background-color 0.3s ease;
    }
    
    /* Tıklanabilir başlık stilleri */
    th.clickable {
        cursor: pointer;
        user-select: none;
        position: relative;
    }
    
    th.clickable:hover {
        background-color: #e9ecef !important;
    }

    /* Seçili başlık göstergesi */
    th.clickable::after {
        content: "✓";
        position: absolute;
        right: 8px;
        top: 50%;
        transform: translateY(-50%);
        opacity: 0;
        color: #007bff;
    }

    th.clickable.selected::after {
        opacity: 1;
    }
</style>

<div class="container mt-4">
    <div class="row">
        <!-- Sol Panel -->
        <div class="col-md-4">
            <h4>Add New Class</h4>
            <form method="post" asp-page-handler="Add">
                <div class="form-group">
                    <label asp-for="NewClass.ClassName"></label>
                    <input asp-for="NewClass.ClassName" class="form-control" />
                    <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="NewClass.StudentCount"></label>
                    <input asp-for="NewClass.StudentCount" class="form-control" />
                    <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="NewClass.Description"></label>
                    <textarea asp-for="NewClass.Description" class="form-control"></textarea>
                    <span asp-validation-for="NewClass.Description" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary mt-2">Add Class</button>
            </form>
        </div>

        <!-- Sağ Panel -->
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4>Class List</h4>
                <div>
                    <button id="exportBtn" class="btn btn-success">Export to JSON</button>
                </div>
            </div>

            <!-- Filter Form -->
            <form method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" asp-for="Filter" class="form-control" placeholder="Filter by Class Name" />
                    <button type="submit" class="btn btn-outline-primary">Filter</button>
                </div>
            </form>

            <!-- Table -->
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th class="clickable @(Model.SelectedColumns.Contains("ClassName") ? "selected" : "")" 
                            data-column="ClassName">Class Name</th>
                        <th class="clickable @(Model.SelectedColumns.Contains("StudentCount") ? "selected" : "")" 
                            data-column="StudentCount">Student Count</th>
                        <th class="clickable @(Model.SelectedColumns.Contains("Description") ? "selected" : "")" 
                            data-column="Description">Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.FilteredTable)
                    {
                        <tr>
                            <td class="@(Model.SelectedColumns.Contains("ClassName") ? "column-highlight" : "")">@item.ClassName</td>
                            <td class="@(Model.SelectedColumns.Contains("StudentCount") ? "column-highlight" : "")">@item.StudentCount</td>
                            <td class="@(Model.SelectedColumns.Contains("Description") ? "column-highlight" : "")">@item.Description</td>
                            <td>
                                <form method="post">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" asp-page-handler="Edit" class="btn btn-warning btn-sm">Edit</button>
                                </form>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            <nav>
                <ul class="pagination">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" href="?Filter=@Model.Filter&PageNumber=@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const exportBtn = document.getElementById('exportBtn');
            const columnHeaders = document.querySelectorAll('th.clickable');
            let selectedColumns = @Html.Raw(Json.Serialize(Model.SelectedColumns ?? new List<string>()));

            // Sütun başlıklarına tıklama özelliği ekleme
            columnHeaders.forEach(header => {
                header.addEventListener('click', function() {
                    const columnName = this.dataset.column;
                    const isSelected = this.classList.contains('selected');

                    // Seçim durumunu güncelle
                    if (isSelected) {
                        selectedColumns = selectedColumns.filter(c => c !== columnName);
                        this.classList.remove('selected');
                    } else {
                        selectedColumns.push(columnName);
                        this.classList.add('selected');
                    }

                    // İlgili sütunu vurgula
                    highlightColumn(columnName, !isSelected);
                });
            });

            // JSON Export işlemi
            exportBtn.addEventListener('click', async function() {
                const currentFilter = '@Model.Filter';
                const currentPage = @Model.PageNumber; // Mevcut sayfa numarası
                
                // Kullanıcıdan onay alma
                const exportType = confirm('Export filtered data only? (OK for current page, Cancel for all data)') 
                    ? 'filtered' 
                    : 'all';

                try {
                    // Sunucuya istek gönder
                    const response = await fetch(
                        `?handler=Export&filter=${exportType}` + 
                        `&selectedColumns=${selectedColumns.join(',')}` +
                        `&currentFilter=${encodeURIComponent(currentFilter)}` +
                        `&currentPage=${currentPage}`
                    );
                    
                    const data = await response.json();

                    if (data.success) {
                        // Dosya indirme işlemi
                        const blob = new Blob([data.jsonData], { type: 'application/json' });
                        const url = URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.href = url;
                        a.download = `classes_${exportType}_${new Date().toISOString().slice(0,10)}.json`;
                        document.body.appendChild(a);
                        a.click();
                        document.body.removeChild(a);
                    } else {
                        alert('Error exporting data: ' + (data.message || 'Unknown error'));
                    }
                } catch (error) {
                    console.error('Export failed:', error);
                    alert('Export işlemi sırasında bir hata oluştu');
                }
            });

            // Sütun vurgulama fonksiyonu
            function highlightColumn(columnName, shouldHighlight) {
                const columnIndex = getColumnIndex(columnName) + 1; // CSS 1-based index
                const cells = document.querySelectorAll(
                    `th:nth-child(${columnIndex}), ` +
                    `td:nth-child(${columnIndex})`
                );
                
                cells.forEach(cell => {
                    cell.classList.toggle('column-highlight', shouldHighlight);
                });
            }

            // Sütun indeks bulma fonksiyonu
            function getColumnIndex(columnName) {
                return Array.from(document.querySelectorAll('th[data-column]'))
                    .findIndex(header => header.dataset.column === columnName);
            }
        });
    </script>
}