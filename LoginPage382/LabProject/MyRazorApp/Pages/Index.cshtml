@page
@model MyRazorApp.Pages.IndexModel
@using MyRazorApp.Models
@{
    ViewData["Title"] = "Class Information";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
        <div class="row">
            <!-- Form Column -->
            <div class="col-md-6">
                <h2>Add New Class</h2>
                <form method="post">
                    <div class="mb-3">
                        <label for="ClassName" class="form-label">Class Name</label>
                        <input type="text" class="form-control" id="ClassName" name="ClassName" required>
                    </div>
                    <div class="mb-3">
                        <label for="StudentCount" class="form-label">Student Count</label>
                        <input type="number" class="form-control" id="StudentCount" name="StudentCount" required>
                    </div>
                    <div class="mb-3">
                        <label for="Description" class="form-label">Description</label>
                        <textarea class="form-control" id="Description" name="Description" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Add Class</button>
                </form>
            </div>

            <!-- Table Column -->
            <div class="col-md-6">
                <h2>Class List</h2>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Class Name</th>
                            <th>Student Count</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var classInfo in Model.ClassList)
                        {
                            <tr>
                                <td>@classInfo.Id</td>
                                <td>@classInfo.ClassName</td>
                                <td>@classInfo.StudentCount</td>
                                <td>@classInfo.Description</td>
                                <td>
                                    <a href="/edit/@classInfo.Id" class="btn btn-warning btn-sm">Edit</a>
                                    <a href="/delete/@classInfo.Id" class="btn btn-danger btn-sm">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>