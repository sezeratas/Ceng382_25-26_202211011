@page
@model MyRazorApp.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="container mt-4">
    <div class="row">
        <!-- Left Panel -->
        <div class="col-md-4">
            <h4>Add New Class</h4>
            <form method="post" asp-page-handler="Add">
                <div class="form-group">
                    <label asp-for="NewClass.ClassName"></label>
                    <input asp-for="NewClass.ClassName" class="form-control" />
                    <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="NewClass.StudentCount"></label>
                    <input asp-for="NewClass.StudentCount" class="form-control" />
                    <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="NewClass.Description"></label>
                    <textarea asp-for="NewClass.Description" class="form-control"></textarea>
                    <span asp-validation-for="NewClass.Description" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary mt-2">Add Class</button>
            </form>
        </div>

        <!-- Right Panel -->
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4>Class List</h4>
                <div>
                    <button id="exportBtn" class="btn btn-success">Export to JSON</button>
                </div>
            </div>

            <!-- Filter Form -->
            <form method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" asp-for="Filter" class="form-control" placeholder="Filter by Class Name" />
                    <button type="submit" class="btn btn-outline-primary">Filter</button>
                </div>
            </form>

            <!-- Column Selection -->
            <div class="mb-3">
                <div class="btn-group" id="columnSelector">
                    <button type="button" class="btn btn-outline-secondary column-btn" data-column="ClassName">Class Name</button>
                    <button type="button" class="btn btn-outline-secondary column-btn" data-column="StudentCount">Student Count</button>
                    <button type="button" class="btn btn-outline-secondary column-btn" data-column="Description">Description</button>
                </div>
                <small class="form-text text-muted">Select columns to export (leave unselected for all columns)</small>
            </div>

            <!-- Table -->
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.FilteredTable)
                    {
                        <tr>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <form method="post">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" asp-page-handler="Edit" class="btn btn-warning btn-sm">Edit</button>
                                </form>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            <nav>
                <ul class="pagination">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" href="?Filter=@Model.Filter&PageNumber=@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
        <script>
        document.addEventListener('DOMContentLoaded', function() {
            const exportBtn = document.getElementById('exportBtn');
            const columnButtons = document.querySelectorAll('.column-btn');
            let selectedColumns = [];

            columnButtons.forEach(btn => {
                btn.addEventListener('click', function() {
                    const column = this.dataset.column;
                    if (this.classList.contains('btn-primary')) {
                        this.classList.remove('btn-primary');
                        this.classList.add('btn-outline-secondary');
                        selectedColumns = selectedColumns.filter(c => c !== column);
                    } else {
                        this.classList.remove('btn-outline-secondary');
                        this.classList.add('btn-primary');
                        selectedColumns.push(column);
                    }
                });
            });

            exportBtn.addEventListener('click', async function() {
                const currentFilter = '@Model.Filter'; // Razor ile modelden al
                const exportType = confirm('Export filtered data only? (OK for filtered, Cancel for all data)') 
                    ? 'filtered' 
                    : 'all';

                const response = await fetch(`?handler=Export&filter=${exportType}&selectedColumns=${selectedColumns.join(',')}&currentFilter=${currentFilter}`);
                const data = await response.json();

                if (data.success) {
                    const blob = new Blob([data.jsonData], { type: 'application/json' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `classes_${exportType}_${new Date().toISOString().slice(0,10)}.json`;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                } else {
                    alert('Error exporting data');
                }
            });
        });
    </script>
}